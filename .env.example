# Local / demo (default): browser localStorage. No database required.
NEXT_PUBLIC_PERSISTENCE=local

# Remote mode (ECS / docker-compose with Postgres): the browser talks to Next.js BFF only.
# NEXT_PUBLIC_PERSISTENCE=remote
# DATABASE_URL=postgres://compass:compass@localhost:5432/compass

# Never put RDS credentials in NEXT_PUBLIC_* variables.
# Set true only when the app is served over HTTPS (ACM/ALB).
# COMPASS_COOKIE_SECURE=false
